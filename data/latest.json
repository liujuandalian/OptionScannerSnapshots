  "claude_analysis": {
    "filename": "claude_analysis_112205.json",
    "github_path": "ClaudeAnalysis/20260805/claude_analysis_112205.json",
    "upload_time": "2026-08-05 11:22",
    "summary": {
      "generated_at": "2026-08-05T11:22:05.890784-04:00",
