  "claude_analysis": {
    "filename": "claude_analysis_152038.json",
    "github_path": "ClaudeAnalysis/20260807/claude_analysis_152038.json",
    "upload_time": "2026-08-07 15:20",
    "summary": {
      "generated_at": "2026-08-07T15:20:38.397156-04:00",
