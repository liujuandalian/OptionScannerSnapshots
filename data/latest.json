  "claude_analysis": {
    "filename": "claude_analysis_124242.json",
    "github_path": "ClaudeAnalysis/20260805/claude_analysis_124242.json",
    "upload_time": "2026-08-05 12:42",
    "summary": {
      "generated_at": "2026-08-05T12:42:42.921570-04:00",
