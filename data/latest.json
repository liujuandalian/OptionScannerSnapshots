  "claude_analysis": {
    "filename": "claude_analysis_123156.json",
    "github_path": "ClaudeAnalysis/20260807/claude_analysis_123156.json",
    "upload_time": "2026-08-07 12:31",
    "summary": {
      "generated_at": "2026-08-07T12:31:56.946086-04:00",
