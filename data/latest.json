  "claude_analysis": {
    "filename": "claude_analysis_120606.json",
    "github_path": "ClaudeAnalysis/20260716/claude_analysis_120606.json",
    "upload_time": "2026-07-16 12:06",
    "summary": {
      "generated_at": "2026-07-16T12:06:06.291494-04:00",
