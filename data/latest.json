    "filename": "claude_analysis_095202.json",
    "github_path": "ClaudeAnalysis/20260812/claude_analysis_095202.json",
    "upload_time": "2026-08-12 09:52",
    "summary": {
      "generated_at": "2026-08-12T09:52:02.709115-04:00",
