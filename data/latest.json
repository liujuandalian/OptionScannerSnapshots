  "claude_analysis": {
    "filename": "claude_analysis_125302.json",
    "github_path": "ClaudeAnalysis/20260720/claude_analysis_125302.json",
    "upload_time": "2026-07-20 12:53",
    "summary": {
      "generated_at": "2026-07-20T12:53:02.585687-04:00",
