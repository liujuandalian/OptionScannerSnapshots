    "filename": "claude_analysis_130456.json",
    "github_path": "ClaudeAnalysis/20260717/claude_analysis_130456.json",
    "upload_time": "2026-07-17 13:05",
    "summary": {
      "generated_at": "2026-07-17T13:04:56.127966-04:00",
